# Qeet ID Kit - optional settings for this computer
#
# NOTHING HERE IS REQUIRED. As shipped, every value is the server's default and
# TEST and STAGING work: sign-up, email, passkeys, sign-in, organizations, OIDC.
# These settings only switch on third-party integrations (sign-in apps, payments,
# SMS, the AI assistant) and tune the server.
#
# HOW TO USE
#   1. Fill in the values you need, here in this file. An empty value means
#      "off / not configured". Never leave a number or a duration empty - delete
#      the line instead to use the default.
#   2. Start the environment again.
#   It applies to every environment started from this kit folder. Update Kit
#   carries your changes over to the new kit folder; if you extract a new ZIP
#   yourself, copy your values into its environments/optional.env.
#
#   TEST CREDENTIALS ONLY. Never put a production key, password or token here.
#   Every email Qeet ID sends goes to the environment's Mail inbox, whatever you set.
#   Security settings and the generated keys are set by the kit; setting them
#   here has no effect (see the reference at the end of this file).
#   In the qeet-id-kit repository, never commit this file with your values: CI
#   refuses it when a secret (*_SECRET, *_TOKEN, *_API_KEY, ...) has a value.
#
# VALUE FORMAT
#   KEY=value                     plain values need no quotes
#   KEY="value with spaces"       double quotes for spaces or # characters
#   PEM keys and other multi-line values go on ONE line inside double quotes,
#   with \n where each line break was:   KEY="<line 1>\n<line 2>\n...\n<last line>"
#   To print a key file in that form:
#     macOS / Linux:  awk 'NF {printf "%s\\n", $0}' AuthKey.p8
#     Windows:        (Get-Content AuthKey.p8) -join '\n'
#
# ADDRESSES
#                                     TEST                            STAGING / DEV (<env>)
#   API (OAuth callbacks, webhooks)   https://api.test.id.qeet.in     http://api.<env>.id.qeet.localhost
#   Console                           https://console.test.id.qeet.in http://console.<env>.id.qeet.localhost
#   From inside Docker, a service running on this computer is host.docker.internal.


# ============================================================================
# Kit behaviour
# ============================================================================

# Open the console in your browser after Start (true/false).
QEET_KIT_OPEN_BROWSER=true

# DEV only: where the DEV start --build finds each source checkout.
# Empty = the sibling folders next to qeet-id-kit (../qeet-id-<component>).
QEET_KIT_DEV_SERVER_SRC=
QEET_KIT_DEV_LOGIN_SRC=
QEET_KIT_DEV_CONSOLE_SRC=
QEET_KIT_DEV_WEBSITE_SRC=
QEET_KIT_DEV_DOCS_SRC=


# ============================================================================
# Sign in with GitHub / Google / Microsoft / Apple (the console's own accounts)
# ============================================================================
# Each provider is OFF until all of its values are set. Register a TEST app at the
# provider with the callback URL for the environment you use:
#   TEST            https://api.test.id.qeet.in/v1/social/<provider>/callback
#   STAGING / DEV   http://api.<env>.id.qeet.localhost/v1/social/<provider>/callback
# Every tester's computer uses the same addresses, so one test app serves the
# whole team. GitHub accepts all of them. Google and Microsoft accept only the
# TEST one (they refuse http and *.localhost callbacks other than plain
# localhost), so test them in TEST.
# (Social sign-in an organization admin configures for its own users is set up
# inside the console, not here.)

# GitHub - Settings > Developer settings > OAuth Apps (one app per environment:
# GitHub allows one callback host per app)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google - Google Cloud console > APIs & Services > Credentials (TEST only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft - Entra admin center > App registrations, type Web (TEST only)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Apple - Services ID, Team ID, Key ID and the .p8 key, all four required
# (TEST only, not verified yet: Apple may ask to verify the domain from the
# internet; the key is one line with \n - see VALUE FORMAT above)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=


# ============================================================================
# Payments and billing
# ============================================================================
# Each payment provider is OFF until its keys are set. With none set, a PAID plan
# is refused ("Online payment isn't available...") - the kit never grants a paid
# plan without payment. The Free plan always works.

# Razorpay - TEST mode keys only (rzp_test_...). Works on this computer: after
# payment the browser hands the signed confirmation back to Qeet ID, so no
# webhook is needed. The webhook secret is optional here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe - TEST mode keys only (sk_test_..., whsec_...). Stripe confirms payment
# only by webhook, which must be forwarded to this computer, e.g. with the
# Stripe CLI:
#   stripe listen --forward-to https://api.test.id.qeet.in/v1/billing/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Which provider serves a billing country: the default ("stripe" or "razorpay")
# plus explicit "CC:provider" routes, comma-separated (e.g. IN:razorpay,US:stripe).
# INR is always Razorpay. To route every country to Razorpay, set the default
# to razorpay.
PAYMENT_DEFAULT_PROVIDER=stripe
PAYMENT_COUNTRY_ROUTES=IN:razorpay

# Invoice tax (GST/VAT): off until the seller's jurisdiction is set. The seller
# state (India) decides CGST+SGST (same state) vs IGST. Rate in basis points
# (1800 = 18%).
BILLING_TAX_ENABLED=false
BILLING_SELLER_COUNTRY=IN
BILLING_SELLER_STATE=
BILLING_GST_RATE_BPS=1800

# Recipient of "Contact sales" notifications (delivered to the Mail inbox).
SALES_EMAIL=sales@qeet.in


# ============================================================================
# SMS (Twilio)
# ============================================================================
# Empty = no SMS is sent; the server only logs that one would have been, without
# the code, so SMS codes cannot be completed. To test SMS, set a Twilio account
# and send only to your own phone - real credentials send real, paid SMS.
# All three are required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=


# ============================================================================
# AI assistant (Qeetai)
# ============================================================================
# Empty provider = the assistant is off (it reports "not configured").
# Provider: "anthropic", or "openai" (also any OpenAI-compatible API through
# QEETAI_BASE_URL). The key stays on the server; use a test/dev key - every
# message is a real, billed request to the provider.
QEETAI_PROVIDER=
QEETAI_API_KEY=
QEETAI_MODEL=claude-sonnet-5
QEETAI_MAX_TOKENS=4096
QEETAI_BASE_URL=


# ============================================================================
# Passwords
# ============================================================================
# The breached-password check itself is switched per environment in
# environments/<env>.env (on by default). It sends only the first
# 5 characters of the password's SHA-1 hash (k-anonymity).
# Reject a password seen in breaches at least this many times (1 = ever seen).
BREACHED_PASSWORD_MIN_COUNT=1
# Pwned Passwords API base URL (empty = the public api.pwnedpasswords.com).
BREACHED_PASSWORD_API_URL=


# ============================================================================
# Tokens and sessions
# ============================================================================
# Go durations (10m, 1h, 720h). The access-token lifetime is also the longest a
# revoked token stays usable, so keep it short.
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=720h


# ============================================================================
# Outbound connections and optional services
# ============================================================================
# Forward proxy for outbound HTTPS (webhooks, auth hooks, SIEM, social providers,
# breached-password check), e.g. http://proxy.example.com:8080. Ambient
# HTTP(S)_PROXY is ignored by design. Empty = connect directly.
EGRESS_PROXY_URL=

# Request header carrying the client's country, set by a trusted proxy (e.g.
# CF-IPCountry); the only input to impossible-travel risk. Nothing in the kit
# sets it - a browser extension that adds the header lets you test that rule.
GEO_COUNTRY_HEADER=

# Push notifications for the Qeet ID Authenticator app (not part of the kit).
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# The kit runs neither Redis nor NATS. Empty = in-process rate limits and a
# log-only event publisher. Point at your own, e.g. redis://host.docker.internal:6379/0
REDIS_URL=
NATS_URL=

# Distributed tracing to an OTLP/HTTP collector, e.g. http://host.docker.internal:4318
# (empty = tracing off). Sampler ratio 0..1.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_RATIO=1


# ============================================================================
# Server tuning (the defaults suit the kit)
# ============================================================================
DB_MIN_CONNS=2
DB_MAX_CONNS=10
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=65536


# ============================================================================
# REFERENCE - set by the kit for each environment (NOT accepted in this file)
# ============================================================================
# These make every environment behave like production apart from its addresses.
# core/compose.yaml sets them; those marked (environment) come from
# environments/<env>.env.
#
#   SERVICE_ENV                  local     production security settings, local addresses
#   SERVICE_PROFILE              <env>     dev, test or staging
#   HTTP_PORT                    4001
#   TRUSTED_PROXY_HOPS           1         the kit's local edge (Caddy)
#   LOG_FORMAT                   json
#   LOG_LEVEL                    (environment) QEET_KIT_SERVER_LOG_LEVEL
#   JWT_ISSUER                   <scheme>://api.<zone>      (environment) zone and scheme:
#   JWT_AUDIENCE                 qeet-id                    TEST https, test.id.qeet.in;
#   APP_BASE_URL                 <scheme>://console.<zone>  STAGING / DEV http,
#   LOGIN_BASE_URL               <scheme>://login.<zone>    <env>.id.qeet.localhost
#   ALLOWED_ORIGINS              the login and console addresses
#   CSRF_COOKIE_DOMAIN           .<zone>
#   CSRF_DISABLED                false     never disabled
#   AUTH_DEV_TRUST_HEADERS       false     never enabled
#   WEBAUTHN_RP_ID               <zone>    passkeys per environment
#   WEBAUTHN_RP_ORIGINS          the login and console addresses
#   WEBAUTHN_RP_DISPLAY_NAME     (environment) QEET_KIT_RP_NAME
#   EMAIL_PROVIDER               smtp      always the environment's Mail inbox
#   SMTP_HOST / SMTP_PORT        mailpit / 1025
#   SMTP_USERNAME / SMTP_PASSWORD  (empty)
#   SMTP_FROM                    (environment) QEET_KIT_SMTP_FROM
#   SECRETS_PROVIDER             static    with the generated SECRETS_KEY below
#   EMBEDDED_WORKERS             true      background jobs run inside the server
#   PAYMENT_SANDBOX              false     never takes payments without charging
#   BILLING_ALLOW_UNPAID_ACTIVATION  false never grants a paid plan without payment
#   BREACHED_PASSWORD_CHECK      (environment) QEET_KIT_BREACHED_PASSWORD_CHECK
#
# ============================================================================
# REFERENCE - generated per computer and environment (NOT accepted in this file)
# ============================================================================
# Random, test-only values created at the first Start, kept in your user folder
# (~/.qeet-id-test-kit/<env>/secrets or %LOCALAPPDATA%\QeetIdTestKit\<env>\secrets)
# and deleted by Reset:
#   DB_URL  JWT_SECRET  JWT_SIGNING_KEY  SECRETS_KEY  SAML_IDP_KEY  SAML_IDP_CERT
#   RELAY_KEYS
#   (plus the database password, the console's SESSION_SECRET and the relay
#   key the console and login send, QEET_ID_RELAY_KEY)
#
# ============================================================================
# REFERENCE - not used by the kit (NOT accepted in this file)
# ============================================================================
#   SERVICE_NAME                 fixed: qeet-id
#   AWS_REGION                   only for SES email; the kit uses the Mail inbox
#   KMS_KEY_ID, SECRETS_WRAPPED_DEK   only for SECRETS_PROVIDER=aws-kms
#   PAYMENT_SANDBOX_BASE_URL     only for PAYMENT_SANDBOX, which is never on
#   JWT_RETIRED_KEYS, JWT_ACTIVATE_SIGNING_KEY, JWT_SIGNING_KEY_RETIRE_GRACE,
#   JWT_SIGNING_KEY_REFRESH_INTERVAL
#                                signing-key rotation needs a new JWT_SIGNING_KEY,
#                                which the kit generates; test rotation elsewhere
#
# ============================================================================
# REFERENCE - the web apps (login, console, website, docs)
# ============================================================================
# Nothing to set. At runtime the kit gives them their addresses, the console
# its session secret, and both the relay key:
#   login     PUBLIC_API_URL, LOGIN_TRUSTED_PROXY_HOPS, QEET_ID_RELAY_KEY (generated)
#   console   PUBLIC_API_URL, SERVER_URL, CONSOLE_TRUSTED_PROXY_HOPS,
#             SESSION_SECRET and QEET_ID_RELAY_KEY (generated)
#   website   CONSOLE_URL, DOCS_URL
#   docs      (none)
# Everything else they read (NEXT_PUBLIC_*, VITE_*) is fixed when the image is
# built and cannot be changed by the kit.
