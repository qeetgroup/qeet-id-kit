# Qeet ID Kit — DEV environment, where developers run Qeet ID routed and gated
# like TEST and STAGING, but from images they build from their own working trees
# (start --build) or choose (start --image <component>=<ref>).
#
# Part of the kit: complete as shipped, the same for every developer, replaced by
# Update Kit. Never edit it (personal settings, including where your source
# checkouts are, go in environments/optional.env).
# No secrets belong here: each computer generates its own at the first start and
# keeps them in the user's state folder, never in the kit.
#
# DEV follows no release channel, so it has no QEET_KIT_CHANNEL. QEET_KIT_RP_NAME
# and QEET_KIT_SMTP_FROM are mandatory (the kit refuses to start DEV without
# them); the others fall back to the default shown here if missing.

# Name developers see when saving a passkey (WEBAUTHN_RP_DISPLAY_NAME).
QEET_KIT_RP_NAME="Qeet ID (Dev)"
# Sender of every email; all mail lands in DEV's Mail inbox (SMTP_FROM).
QEET_KIT_SMTP_FROM="Qeet ID DEV <no-reply@dev.id.qeet.localhost>"
# Server log level: debug, info, warn or error (LOG_LEVEL).
QEET_KIT_SERVER_LOG_LEVEL=debug
# Reject passwords found in public breaches (BREACHED_PASSWORD_CHECK).
QEET_KIT_BREACHED_PASSWORD_CHECK=true
# Empty baseline (TEST-STRATEGY: testers create their own data through the
# product). A synthetic seed runs only if this is true AND the release manifest
# declares one — neither is the case today.
QEET_KIT_SEED=false

# ============================================================================
# REFERENCE — what DEV gives Qeet ID (set by the kit from the values above and
# the environment's name; nothing to edit)
# ============================================================================
#   Images             start --build: qeet-id-<component>:dev, built from
#                      ../qeet-id-<component> next to the kit folder, or from
#                      QEET_KIT_DEV_<COMPONENT>_SRC in environments/optional.env
#                      start --image <component>=<ref>: that image instead
#                      start (neither): the images DEV ran last time
#   Addresses          console   http://console.dev.id.qeet.localhost
#                      login     http://login.dev.id.qeet.localhost
#                      API       http://api.dev.id.qeet.localhost  (OIDC issuer)
#                      website   http://dev.id.qeet.localhost
#                      docs      http://docs.dev.id.qeet.localhost
#                      mail      http://mail.dev.id.qeet.localhost
#   Passkeys           WEBAUTHN_RP_ID=dev.id.qeet.localhost (DEV only)
#   Cookies            CSRF_COOKIE_DOMAIN=.dev.id.qeet.localhost (DEV only)
#   Server mode        SERVICE_ENV=local, SERVICE_PROFILE=dev
#   Database           qeet_id_dev, Docker volume qeet-id-dev-postgres
#   Mail inbox         Docker volume qeet-id-dev-mail
#   Secrets            generated in ~/.qeet-id-test-kit/dev/secrets
#                      (%LOCALAPPDATA%\QeetIdTestKit\dev\secrets on Windows)
#   Optional extras    environments/optional.env
