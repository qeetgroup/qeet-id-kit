# Qeet ID Kit — TEST environment, where QA tests the current release candidate.
#
# Part of the kit: complete as shipped, the same for every tester, replaced by
# Update Kit. Testers never edit it (personal settings go in environments/optional.env).
# No secrets belong here: each computer generates its own at the first start and
# keeps them in the user's state folder, never in the kit.
#
# Every value below is part of TEST's definition. QEET_KIT_CHANNEL,
# QEET_KIT_ZONE, QEET_KIT_SCHEME, QEET_KIT_RP_NAME and QEET_KIT_SMTP_FROM are
# mandatory (the kit refuses to start TEST without them); the others fall back
# to the default shown here if missing.

# Release channel TEST follows (ghcr.io/qeetgroup/qeet-id-release:<channel>).
QEET_KIT_CHANNEL=test
# TEST's addresses: <service>.<zone>, the website at the zone itself. Public DNS
# points every name in test.id.qeet.in at 127.0.0.1, so they reach only this
# computer, and https lets Google, Microsoft and Apple sign-in work (they refuse
# *.localhost). The edge serves them with certificates from this computer's own
# certificate authority, which Start asks once to trust.
QEET_KIT_ZONE=test.id.qeet.in
QEET_KIT_SCHEME=https
# Name testers see when saving a passkey (WEBAUTHN_RP_DISPLAY_NAME).
QEET_KIT_RP_NAME="Qeet ID (Test)"
# Sender of every email; all mail lands in TEST's Mail inbox (SMTP_FROM).
QEET_KIT_SMTP_FROM="Qeet ID TEST <no-reply@test.id.qeet.in>"
# Server log level: debug, info, warn or error (LOG_LEVEL).
QEET_KIT_SERVER_LOG_LEVEL=info
# Reject passwords found in public breaches (BREACHED_PASSWORD_CHECK).
QEET_KIT_BREACHED_PASSWORD_CHECK=true
# Empty baseline (TEST-STRATEGY: testers create their own data through the
# product). A synthetic seed runs only if this is true AND the release manifest
# declares one — neither is the case today.
QEET_KIT_SEED=false

# ============================================================================
# REFERENCE — what TEST gives Qeet ID (set by the kit from the values above and
# the environment's name; nothing to edit)
# ============================================================================
#   Addresses          console   https://console.test.id.qeet.in
#                      login     https://login.test.id.qeet.in
#                      API       https://api.test.id.qeet.in  (OIDC issuer)
#                      website   https://test.id.qeet.in
#                      docs      https://docs.test.id.qeet.in
#                      mail      https://mail.test.id.qeet.in
#                      (http:// on any of them redirects to https://)
#   Sign-in callbacks  https://api.test.id.qeet.in/v1/social/<provider>/callback
#   Passkeys           WEBAUTHN_RP_ID=test.id.qeet.in (TEST only)
#   Cookies            CSRF_COOKIE_DOMAIN=.test.id.qeet.in (TEST only)
#   Certificates       issued by the edge from this computer's certificate
#                      authority, ~/.qeet-id-test-kit/edge/ca/root.crt
#                      (%LOCALAPPDATA%\QeetIdTestKit\edge\ca\root.crt on Windows)
#   Server mode        SERVICE_ENV=local, SERVICE_PROFILE=test
#   Database           qeet_id_test, Docker volume qeet-id-test-postgres
#   Mail inbox         Docker volume qeet-id-test-mail
#   Secrets            generated in ~/.qeet-id-test-kit/test/secrets
#                      (%LOCALAPPDATA%\QeetIdTestKit\test\secrets on Windows)
#   Optional extras    environments/optional.env
