# Qeet ID Kit — STAGING environment, where Product/UAT validates the candidate QA
# approved: the exact image digests TEST ran, promoted to the staging channel.
#
# Part of the kit: complete as shipped, the same for every tester, replaced by
# Update Kit. Testers never edit it (personal settings go in environments/optional.env).
# No secrets belong here: each computer generates its own at the first start and
# keeps them in the user's state folder, never in the kit.
#
# Every value below is part of STAGING's definition. QEET_KIT_CHANNEL,
# QEET_KIT_ZONE, QEET_KIT_SCHEME, QEET_KIT_RP_NAME and QEET_KIT_SMTP_FROM are
# mandatory (the kit refuses to start STAGING without them); the others fall
# back to the default shown here if missing.

# Release channel STAGING follows (ghcr.io/qeetgroup/qeet-id-release:<channel>).
QEET_KIT_CHANNEL=staging
# STAGING's addresses: <service>.<zone>, the website at the zone itself. Public DNS
# points every name in staging.id.qeet.in at 127.0.0.1, so they reach only this
# computer, and https lets Google, Microsoft and Apple sign-in work (they refuse
# *.localhost). The edge serves them with certificates from this computer's own
# certificate authority, which Start asks once to trust.
QEET_KIT_ZONE=staging.id.qeet.in
QEET_KIT_SCHEME=https
# Name testers see when saving a passkey (WEBAUTHN_RP_DISPLAY_NAME).
QEET_KIT_RP_NAME="Qeet ID (Staging)"
# Sender of every email; all mail lands in STAGING's Mail inbox (SMTP_FROM).
QEET_KIT_SMTP_FROM="Qeet ID STAGING <no-reply@staging.id.qeet.in>"
# Qeet ID on the phone, which may use this environment's passkeys to sign in to
# administration (WEBAUTHN_RP_ORIGINS): Android's origin is
# android:apk-key-hash:<its signing certificate's SHA-256, base64url>.
QEET_KIT_APP_ORIGINS=android:apk-key-hash:-ekpoNgAuBJabtkv3B_bbyGveG0JH9YwB1E3Sr-SJBY
# Server log level: debug, info, warn or error (LOG_LEVEL).
QEET_KIT_SERVER_LOG_LEVEL=info
# Reject passwords found in public breaches (BREACHED_PASSWORD_CHECK).
QEET_KIT_BREACHED_PASSWORD_CHECK=true
# Empty baseline (TEST-STRATEGY: testers create their own data through the
# product). A synthetic seed runs only if this is true AND the release manifest
# declares one — neither is the case today.
QEET_KIT_SEED=false

# ============================================================================
# REFERENCE — what STAGING gives Qeet ID (set by the kit from the values above
# and the environment's name; nothing to edit)
# ============================================================================
#   Addresses          console   https://console.staging.id.qeet.in
#                      login     https://login.staging.id.qeet.in
#                      API       https://api.staging.id.qeet.in  (OIDC issuer)
#                      website   https://staging.id.qeet.in
#                      docs      https://docs.staging.id.qeet.in
#                      mail      https://mail.staging.id.qeet.in
#                      (http:// on any of them redirects to https://)
#   Sign-in callbacks  https://api.staging.id.qeet.in/v1/social/<provider>/callback
#   Passkeys           WEBAUTHN_RP_ID=staging.id.qeet.in (STAGING only)
#   Cookies            CSRF_COOKIE_DOMAIN=.staging.id.qeet.in (STAGING only)
#   Certificates       issued by the edge from this computer's certificate
#                      authority, ~/.qeet-id-test-kit/edge/ca/root.crt
#                      (%LOCALAPPDATA%\QeetIdTestKit\edge\ca\root.crt on Windows)
#   Server mode        SERVICE_ENV=local, SERVICE_PROFILE=staging
#   Database           qeet_id_staging, Docker volume qeet-id-staging-postgres
#   Mail inbox         Docker volume qeet-id-staging-mail
#   Secrets            generated in ~/.qeet-id-test-kit/staging/secrets
#                      (%LOCALAPPDATA%\QeetIdTestKit\staging\secrets on Windows)
#   Optional extras    environments/optional.env
