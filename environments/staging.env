# Qeet ID Kit — STAGING environment, where Product/UAT validates the candidate QA
# approved: the exact image digests TEST ran, promoted to the staging channel.
#
# Part of the kit: complete as shipped, the same for every tester, replaced by
# Update Kit. Testers never edit it (personal settings go in environments/optional.env).
# No secrets belong here: each computer generates its own at the first start and
# keeps them in the user's state folder, never in the kit.
#
# Every value below is part of STAGING's definition. QEET_KIT_CHANNEL,
# QEET_KIT_RP_NAME and QEET_KIT_SMTP_FROM are mandatory (the kit refuses to start
# STAGING without them); the others fall back to the default shown here if missing.

# Release channel STAGING follows (ghcr.io/qeetgroup/qeet-id-release:<channel>).
QEET_KIT_CHANNEL=staging
# Name testers see when saving a passkey (WEBAUTHN_RP_DISPLAY_NAME).
QEET_KIT_RP_NAME="Qeet ID (Staging)"
# Sender of every email; all mail lands in STAGING's Mail inbox (SMTP_FROM).
QEET_KIT_SMTP_FROM="Qeet ID STAGING <no-reply@staging.id.qeet.localhost>"
# Server log level: debug, info, warn or error (LOG_LEVEL).
QEET_KIT_SERVER_LOG_LEVEL=info
# Reject passwords found in public breaches (BREACHED_PASSWORD_CHECK).
QEET_KIT_BREACHED_PASSWORD_CHECK=true
# Empty baseline (TEST-STRATEGY: testers create their own data through the
# product). A synthetic seed runs only if this is true AND the release manifest
# declares one — neither is the case today.
QEET_KIT_SEED=false

# ============================================================================
# REFERENCE — what STAGING gives Qeet ID (set by the kit from the values above
# and the environment's name; nothing to edit)
# ============================================================================
#   Addresses          console   http://console.staging.id.qeet.localhost
#                      login     http://login.staging.id.qeet.localhost
#                      API       http://api.staging.id.qeet.localhost  (OIDC issuer)
#                      website   http://staging.id.qeet.localhost
#                      docs      http://docs.staging.id.qeet.localhost
#                      mail      http://mail.staging.id.qeet.localhost
#   Passkeys           WEBAUTHN_RP_ID=staging.id.qeet.localhost (STAGING only)
#   Cookies            CSRF_COOKIE_DOMAIN=.staging.id.qeet.localhost (STAGING only)
#   Server mode        SERVICE_ENV=local, SERVICE_PROFILE=staging
#   Database           qeet_id_staging, Docker volume qeet-id-staging-postgres
#   Mail inbox         Docker volume qeet-id-staging-mail
#   Secrets            generated in ~/.qeet-id-test-kit/staging/secrets
#                      (%LOCALAPPDATA%\QeetIdTestKit\staging\secrets on Windows)
#   Optional extras    environments/optional.env
