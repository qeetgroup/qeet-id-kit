# Nothing personal, secret or built is ever committed.

# Env files with personal values. (Testers edit environments/optional.env in place;
# CI keeps the committed copy at its defaults: tests/checks/check-optional-env.sh.)
.env
.env.*

# Added to the release ZIP by the package workflow; pins the kit image by digest
kit.lock

# Release output
*.zip
*.sha256
dist/

# Keys and certificates
*.pem
*.key
*.p12
*.pfx

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
