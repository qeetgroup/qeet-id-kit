{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qeetgroup/qeet-id-deploy/test-kit/manifests/manifest.schema.json",
  "title": "Qeet ID release candidate manifest",
  "description": "Bill of materials for one Qeet ID product release candidate, published as ghcr.io/qeetgroup/qeet-id-release:<version> and pointed to by the qa / uat / production-approved channels. Assembled only by qeet-id-deploy (publish-candidate workflow).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "version",
    "release",
    "candidate",
    "createdAt",
    "createdBy",
    "workflowRun",
    "dataEpoch",
    "minTestKitVersion",
    "components"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "qeet-id" },
    "version": {
      "description": "Product release candidate: <release>-rc.<candidate>.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-rc\\.[1-9][0-9]*$"
    },
    "release": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "candidate": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string", "minLength": 1 },
    "workflowRun": { "type": "string", "minLength": 1 },
    "dataEpoch": {
      "description": "Local data compatibility generation. Monotonic; bumped only when a release cannot use an existing test-kit database (the kit then requires Reset).",
      "type": "integer",
      "minimum": 1
    },
    "minTestKitVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server", "login", "console", "website", "docs"],
      "properties": {
        "server": {
          "allOf": [
            { "$ref": "#/$defs/component" },
            { "required": ["schemaVersion"] }
          ]
        },
        "login": { "$ref": "#/$defs/component" },
        "console": { "$ref": "#/$defs/component" },
        "website": { "$ref": "#/$defs/component" },
        "docs": { "$ref": "#/$defs/component" }
      }
    },
    "seed": {
      "description": "Optional synthetic seed command (arguments to the server image). Runs only on a fresh environment whose profile sets QEET_KIT_SEED=true. Unused today: the baseline is empty.",
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._:/=-]+$" }
        }
      }
    },
    "notes": { "type": "string", "maxLength": 2000 }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag", "digest", "repository", "revision", "sourceBranch", "platforms"],
      "properties": {
        "image": {
          "description": "Image repository without tag or digest.",
          "type": "string",
          "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+$"
        },
        "tag": { "type": "string", "pattern": "^sha-[0-9a-f]{40}$" },
        "digest": {
          "description": "Index (multi-platform) digest; the immutable artifact.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "repository": { "type": "string", "pattern": "^qeetgroup/qeet-id-(server|login|console|website|docs)$" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceBranch": {
          "type": "string",
          "pattern": "^release/(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^linux/[a-z0-9]+(/v[0-9]+)?$" }
        },
        "schemaVersion": {
          "description": "Highest database migration in the server image (in.qeet.id.schema-version).",
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
